# ── 🌐 Langue / Language ──────────────────────
# Langue du bot : en (défaut) ou fr. Surchargeable par --lang=xx au lancement.
# BOT_LANGUAGE=en

# ── 🤖 Discord ────────────────────────────────
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_OWNER_ID=YOUR_DISCORD_OWNER_ID
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# ── 🎛️ Provider (type de serveur piloté) ──────
# Identifiant technique (défaut : yorkhost).
# PROVIDER=yorkhost
# Optionnel : surcharge l'URL de base par défaut du provider.
# PROVIDER_API_URL=
PROVIDER_API_KEY=YOUR_PROVIDER_API_KEY

# ── 🎮 Services (cibles pilotées) ──────────────
# Mode mono-cible : un seul ID ici.
PROVIDER_SERVICE_ID=YOUR_PROVIDER_SERVICE_ID
# Mode multi-cibles : alias=id séparés par des virgules.
# Si défini, remplace PROVIDER_SERVICE_ID. Chaque alias devient un choix dans les commandes.
# PROVIDER_SERVICES=main=svc-abc,survival=svc-def

# ── 🔔 Watchdog (optionnel) ────────────────────
# ID du salon Discord où envoyer les alertes automatiques. Si absent → watchdog désactivé.
# DISCORD_ALERT_CHANNEL_ID=YOUR_ALERT_CHANNEL_ID
# Intervalle entre deux scans du watchdog en millisecondes (défaut : 60000).
# ALERT_INTERVAL_MS=60000
