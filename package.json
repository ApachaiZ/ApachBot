{
  "name": "apach-bot",
  "version": "1.0.0",
  "description": "Discord bot to control remote servers via pluggable REST providers",
  "main": "apach-bot.js",
  "type": "commonjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node apach-bot.js",
    "test": "node --test",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop apach-bot",
    "pm2:restart": "pm2 restart apach-bot",
    "pm2:reload": "pm2 reload apach-bot",
    "pm2:delete": "pm2 delete apach-bot",
    "pm2:logs": "pm2 logs apach-bot",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0"
  }
}
